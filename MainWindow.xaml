<Window x:Class="GrzmotoEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VocaGrzmot - VOCALOID VOICEBANK EDITOR"
        Icon="/assets/vocagrzmot.png"
        Width="1250"
        Height="790"
        MinWidth="900"
        MinHeight="580"
        Background="#0B0D15"
        Foreground="#ECECF8"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#151824"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#28243E"/>
            <Setter Property="Foreground" Value="#F1ECFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202333"/>
            <Setter Property="Foreground" Value="#F5F3FF"/>
            <Setter Property="CaretBrush" Value="#C4A5FF"/>
            <Setter Property="BorderBrush" Value="#34364B"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EDEBFA"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#41345E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#302A43"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True"
                                      Margin="0,0,0,14"
                                      KeyboardNavigation.TabIndex="1"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              KeyboardNavigation.TabIndex="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#B8B2CC"/>
            <Setter Property="Background" Value="#151824"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#7853D7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#302A43"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#8968E0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl Margin="22">
        <TabItem Header="Grzmoto Editor">
            <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/assets/vocagrzmot.png"
                               Width="64"
                               Height="64"
                               Stretch="Uniform"
                               Margin="0,0,14,0"
                               ToolTip="VocaGrzmot"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VocaGrzmot - VOCALOID VOICEBANK EDITOR"
                                       Foreground="#A88CFF"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Voicebank timing editor"
                                       FontSize="27"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="＋ New" Click="New_Click"/>
                        <Button Content="WAV folder" Click="SelectWavFolder_Click"/>
                        <Button Content="Open JSON" Click="Open_Click"/>
                        <Button Content="Save"
                                Background="#7853D7"
                                Click="Save_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="310"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource Panel}"
                            CornerRadius="14"
                            Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="PHONEME ENTRIES"
                                           FontWeight="Bold"
                                           Foreground="#B4A3E8"
                                           Margin="0,0,0,12"/>
                                <TextBox x:Name="SearchBox"
                                         TextChanged="Search_Changed"
                                         ToolTip="Filter by alias or filename"/>
                                <Button Content="＋ Add entry"
                                        Click="Add_Click"
                                        Margin="0,12,0,12"/>
                            </StackPanel>
                            <ListBox x:Name="EntryList"
                                     DisplayMemberPath="Alias"
                                     SelectionChanged="EntryList_SelectionChanged"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource Panel}"
                            CornerRadius="14"
                            Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="TIMING WORKSPACE"
                                           Foreground="#B4A3E8"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="CurrentAlias"
                                           Text="Select a phoneme entry"
                                           FontSize="25"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2"
                                       Text="Waveform and boundaries · milliseconds · drag a marker to adjust"
                                       Foreground="#AAA9C2"/>
                            <Border Grid.Row="4"
                                    Background="#10121D"
                                    CornerRadius="12"
                                    Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Canvas x:Name="WaveformCanvas"
                                            ClipToBounds="True"
                                            Background="#10121D"
                                            SizeChanged="WaveformCanvas_SizeChanged"
                                            MouseLeftButtonDown="WaveformCanvas_MouseLeftButtonDown"
                                            MouseMove="WaveformCanvas_MouseMove"
                                            MouseLeftButtonUp="WaveformCanvas_MouseLeftButtonUp"/>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock x:Name="WaveformStatus"
                                                   Text="Select a WAV folder, then select an entry."
                                                   Foreground="#898BA7"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,0"/>
                                        <ItemsControl x:Name="Timeline" Margin="0,10,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#352B51"
                                                            CornerRadius="6"
                                                            Padding="12,8"
                                                            Margin="0,0,7,0">
                                                        <TextBlock Text="{Binding}" Foreground="#E6D8FF"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4"
                            Background="{StaticResource Panel}"
                            CornerRadius="14"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="INSPECTOR"
                                       Foreground="#B4A3E8"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,0,0,22"/>
                            <TextBlock Text="Phonetic alias (Vocaloid phoneme format, not hiragana or ARPAbet)"
                                       Margin="0,0,0,7"/>
                            <TextBox x:Name="AliasBox"/>
                            <TextBlock Text="Audio file" Margin="0,18,0,7"/>
                            <TextBox x:Name="AudioBox"/>
                            <TextBlock Text="Timing boundaries (ms)" Margin="0,18,0,7"/>
                            <TextBox x:Name="TimingBox"
                                     ToolTip="Separate timings with semicolons; decimal commas are supported"/>
                            <TextBlock Text="Example: 0; 100; 150; 500"
                                       Foreground="#8C8EA9"
                                       FontSize="12"
                                       Margin="0,7,0,20"/>
                            <Button Content="Apply changes"
                                    Background="#7853D7"
                                    Click="Apply_Click"
                                    Margin="0,0,0,10"/>
                            <Button Content="Delete entry"
                                    Background="#482837"
                                    Click="Delete_Click"/>
                            <TextBlock x:Name="ValidationText"
                                       Foreground="#F3B0B9"
                                       TextWrapping="Wrap"
                                       Margin="0,20,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText"
                               Text="Ready · no file loaded"
                               Foreground="#9D9DB5"/>
                    <TextBlock Grid.Column="1"
                               Text="GRZMOTO.JSON  •  C# / WPF"
                               Foreground="#766F92"/>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Scripts">
            <Grid Margin="0,4,0,0">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Source="/assets/vocagrzmot.png"
                           Width="320"
                           Height="320"
                           Stretch="Uniform"
                           Margin="0,0,0,24"/>
                    <TextBlock Text="COMING SOON"
                               HorizontalAlignment="Center"
                               Foreground="#C4A5FF"
                               FontSize="32"
                               FontWeight="Bold"
                               FontStretch="Expanded"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Export">
            <Grid Margin="0,4,0,0">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Source="/assets/vocagrzmot.png"
                           Width="320"
                           Height="320"
                           Stretch="Uniform"
                           Margin="0,0,0,24"/>
                    <TextBlock Text="COMING SOON"
                               HorizontalAlignment="Center"
                               Foreground="#C4A5FF"
                               FontSize="32"
                               FontWeight="Bold"
                               FontStretch="Expanded"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
